# ---------------------------------------------------------------
# MÔI TRƯỜNG PRODUCTION — VÍ DỤ MẪU
# Copy sang .env và điền giá trị thật. KHÔNG commit .env thật.
# ---------------------------------------------------------------
CI_ENVIRONMENT = production
app.baseURL = 'https://volt.example.com/'

# Bật HTTPS-hardening (secure cookie + force global secure request)
app.forceGlobalSecureRequests = true
cookie.secure = true

cache.handler = redis
cache.backupHandler = file
cache.prefix = volt_
cache.ttl = 86400
cache.redis.host = <REDIS_HOST>
cache.redis.port = 6379
cache.redis.password = <REDIS_PASSWORD>
cache.redis.database = 1
volt.metadata.cacheTtl = 86400

database.default.hostname = <DB_HOST>
database.default.database = volt_enterprise
database.default.username = volt_admin
database.default.password = <DB_PASSWORD>
database.default.DBDriver = Postgre
database.default.schema = public
database.default.DBPrefix = 
database.default.port     = 5432

app.cors.allowedOrigins = 'https://volt.example.com'

session.redis.host = <REDIS_HOST>
session.redis.port = 6379
session.redis.password = <REDIS_PASSWORD>
session.redis.database = 2

# Error alert webhook (P0)
# volt.alertWebhookUrl = 'https://hooks.slack.com/services/xxx'
# volt.alertWebhookSecret = '<HYMAC_SECRET>'
# volt.alertMinLevel = error

# Backup retention (P0)
# volt.backupRetentionDays = 30
# volt.alertWebhookUrl = ''